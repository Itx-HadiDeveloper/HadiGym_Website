# Server
PORT=5000
NODE_ENV=development

# CORS - comma separated list of allowed origins in production
CLIENT_ORIGIN=http://localhost:5000

# Email (optional) - used by utils/mailer.js to email the gym owner when a
# contact form / free trial request comes in. Leave blank to disable email
# sending; submissions are always saved to backend/data regardless.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
GYM_NOTIFY_EMAIL=info@abdullahmallgym.com
